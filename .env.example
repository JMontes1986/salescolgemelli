NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_solo_servidor
# Debe ser privado, estable y de al menos 32 caracteres; firma la sesion web.
AUTH_COOKIE_SECRET=pon_aqui_un_secreto_largo_y_privado_de_32_caracteres
# Debe ser privado, estable y diferente al secreto de sesion; no cambiarlo despues de enrolar FreeOTP.
# Si se omite temporalmente, la app usa AUTH_COOKIE_SECRET para conservar compatibilidad con cuentas ya enroladas.
ADMIN_TOTP_SECRET=pon_aqui_otro_secreto_largo_y_privado_de_32_caracteres
# Activar temporalmente para enrolar el QR de FreeOTP del administrador; dejar en false despues.
ADMIN_FREEOTP_SETUP_ENABLED=false
# Self-service security (server only, minimum 32 random characters)
SELF_SERVICE_SESSION_SECRET=
# Bre-B manual: the key and official bank-issued QR payload are intentionally public to the payer.
NEXT_PUBLIC_BREB_ENABLED=true
NEXT_PUBLIC_BREB_KEY=
NEXT_PUBLIC_BREB_ACCOUNT_NAME=Colegio Franciscano Agustín Gemelli
NEXT_PUBLIC_BREB_QR_PAYLOAD=
# Applied in Supabase as app.breb_reported_reservation_minutes; default is 1440.
BREB_REPORTED_RESERVATION_MINUTES=1440
NEXT_PUBLIC_BINGO_WHATSAPP_NUMBER=573XXXXXXXXX
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=600
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
GROQ_API_KEY=
GROQ_SECURITY_MODEL=openai/gpt-oss-safeguard-20b
GROQ_SECURITY_FALLBACK_MODELS=llama-3.1-8b-instant
